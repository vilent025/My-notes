"""
#open()可以打开或者创建一个新文件
#open(name, mode, encoding)
    name：要打开的目标文件名的字符串(可以包含文件所在的具体路径)
    mode：设置打开文件的模式：只读、写入、追加等
        r：只读
        w：写入，重新编辑，之前的内容会被删除，若文件不存在就会创建新文件
        a：对文件内容进行追加，写入原有内容之后
    encoding：编码格式（UTH-8）
实例：f = open('python.txt', 'r', encoding = "UTF-8")
    print(f.read())
    print(f.read(10))  #只读取10个字符

    lines = f.readlines()  #读取文件的全部行，封装到列表中
    print(lines)

    line = f.readline()  #只读读取一行
    print(line)


"""

f = open("test.txt", "r", encoding = "UTF-8")

content = f.read()
print(content)

for line in f:  #输出每一行数据
    print(line)

#文件的关闭
f.close()

#with open
#自动close文件
with open("test.txt", "r", encoding = "UTF-8") as f2:  #把open的内容赋值给f2
    print(f2.read())
